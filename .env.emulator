# `npm run dev:firebase`: the real Firebase code, against the local emulators (`npm run emulators`)
VITE_TRANSPORT=firebase
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mafia.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-mafia
VITE_FIREBASE_PROJECT_ID=demo-mafia
VITE_FIREBASE_APP_ID=demo-app
